# Supabase: Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI: será usada nas próximas etapas
OPENAI_API_KEY=your-openai-api-key

# Segredo compartilhado somente entre o BFF Ktor e este serviço
INTERNAL_API_SECRET=replace-with-at-least-16-random-characters

# Estes modelos mantêm o embedding compatível com vector(1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
